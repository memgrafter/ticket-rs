<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: setup/queue.sh install replaces __HOME__.
     vert's 127.0.0.1:7878 forwards to this Mac's tk queue serve. launchd
     restarts ssh when it exits (link down, forward refused, keep-alive lost). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.tk.queue-tunnel-vert</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-N</string>
        <string>-T</string>
        <string>-o</string>
        <string>BatchMode=yes</string>
        <string>-o</string>
        <string>ConnectTimeout=15</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-R</string>
        <string>127.0.0.1:7878:127.0.0.1:7878</string>
        <string>vert</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/tk/queue-tunnel-vert.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/tk/queue-tunnel-vert.log</string>
</dict>
</plist>
